  "question": "Where can I find a fast food restaurant in the west direction of Lockheed A-12 Blackbird, San Diego, CA, limited to 70 kilometers?",
  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE amenity = 'fast_food' AND ST_DWithin( geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Lockheed A-12 Blackbird%' AND addr_city ILIKE '%San Diego%' AND addr_state ILIKE '%CA%' LIMIT 1 ), 70000 ) AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Lockheed A-12 Blackbird%' AND addr_city ILIKE '%San Diego%' AND addr_state ILIKE '%CA%' LIMIT 1 ), geometry )) BETWEEN 247.5 AND 292.5;",
