{
  "question": "Within a radius of 140 kilometers, where can I locate café heading toward International Circus Hall of Fame, Peru, IN from Daubenspeck Nature Reserve, Indianapolis, IN?",
  "sql": "WITH start_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Daubenspeck Nature Reserve%' AND addr_city ILIKE '%Indianapolis%' AND addr_state ILIKE '%IN%' LIMIT 1 ), end_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%International Circus Hall of Fame%' AND addr_city ILIKE '%Peru%' AND addr_state ILIKE '%IN%' LIMIT 1 ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, start_point AS sp, end_point AS ep WHERE p.amenity = 'cafe' AND sp.geometry IS NOT NULL AND ep.geometry IS NOT NULL AND ST_DWithin(p.geometry::geography, sp.geometry::geography, 140000) -- within 140 kilometers (140,000 meters) of the starting point AND ( -- Calculate the angular difference between the bearing from the start point to the cafe -- and the bearing from the start point to the destination. -- Filter for cafes that are within +/- 45 degrees of the main heading. LEAST( ABS(degrees(ST_Azimuth(sp.geometry, p.geometry)) - degrees(ST_Azimuth(sp.geometry, ep.geometry))), 360 - ABS(degrees(ST_Azimuth(sp.geometry, p.geometry)) - degrees(ST_Azimuth(sp.geometry, ep.geometry))) ) <= 45 ) ORDER BY ST_Distance(sp.geometry::geography, p.geometry::geography) ASC;",
