{
  "question": "Within 20 kilometers of Centennial High School Football Stadium, Roswell, GA, where can I find a hotel toward Braelinn Recreation Center, Peachtree City, GA?",
  "sql": "WITH origin AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Centennial High School Football Stadium%' AND addr_city ILIKE '%Roswell%' AND addr_state ILIKE '%GA%' LIMIT 1 ), target AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Braelinn Recreation Center%' AND addr_city ILIKE '%Peachtree City%' AND addr_state ILIKE '%GA%' LIMIT 1 ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, origin AS o, target AS t WHERE p.tourism = 'hotel' AND ST_DWithin(p.geometry::geography, o.geometry::geography, 20000) -- Within 20 kilometers (20000 meters) of the origin AND ( -- Ensure azimuth can be calculated (points are not identical) DEGREES(ST_Azimuth(o.geometry, p.geometry)) IS NOT NULL AND DEGREES(ST_Azimuth(o.geometry, t.geometry)) IS NOT NULL ) AND COS(RADIANS( -- Calculate the angular difference between the bearing from origin to hotel -- and the bearing from origin to target. DEGREES(ST_Azimuth(o.geometry, p.geometry)) - DEGREES(ST_Azimuth(o.geometry, t.geometry)) )) >= COS(RADIANS(22.5)) -- Filter for hotels within +/- 22.5 degrees of the target direction ORDER BY ST_Distance(p.geometry::geography, o.geometry::geography) ASC;",
