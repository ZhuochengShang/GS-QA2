{
  "question": "Where can I locate attraction within 60 kilometers when heading toward Hyatt Regency Greenwich, Old Greenwich, CT starting at Children's Hospital at Montefiore, Bronx, NY?",
  "sql": "WITH start_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Children''s Hospital at Montefiore%' AND addr_city ILIKE '%Bronx%' AND addr_state ILIKE '%NY%' LIMIT 1 ), target_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Hyatt Regency Greenwich%' AND addr_city ILIKE '%Old Greenwich%' AND addr_state ILIKE '%CT%' LIMIT 1 ), bearing_info AS ( SELECT (SELECT geometry FROM start_point) AS start_geom, (SELECT geometry FROM target_point) AS target_geom, ST_Azimuth((SELECT geometry FROM start_point), (SELECT geometry FROM target_point)) AS direct_bearing_radians ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, bearing_info AS bi WHERE p.tourism = 'attraction' AND ST_DWithin(p.geometry::geography, bi.start_geom::geography, 60000) -- within 60 km of the starting point AND ( -- Calculate the angular difference between the direct bearing to the target -- and the bearing from the start point to the current attraction. -- The LEAST function handles angle wrap-around (e.g., 10 degrees vs 350 degrees). LEAST( ABS(DEGREES(ST_Azimuth(bi.start_geom, p.geometry)) - DEGREES(bi.direct_bearing_radians)), 360 - ABS(DEGREES(ST_Azimuth(bi.start_geom, p.geometry)) - DEGREES(bi.direct_bearing_radians)) ) ) <= 45 -- within a +/- 45 degree cone towards the target ORDER BY ST_Distance(p.geometry::geography, bi.start_geom::geography) ASC;",
