{
  "question": "Within 150 kilometers, where can I find a hotel toward Sculpture Plaza, Mountain View, CA from the View Lounge, San Francisco, CA?",
  "sql": "WITH locations AS ( SELECT (SELECT geometry FROM pois WHERE poi_name ILIKE '%View Lounge%' AND addr_city ILIKE '%San Francisco%' LIMIT 1) AS start_geom, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Sculpture Plaza%' AND addr_city ILIKE '%Mountain View%' LIMIT 1) AS target_geom ), azimuth_calc AS ( SELECT start_geom, degrees(ST_Azimuth(start_geom, target_geom)) AS target_azimuth FROM locations ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, azimuth_calc AS ac WHERE p.tourism = 'hotel' AND ST_DWithin(p.geometry::geography, ac.start_geom::geography, 150000) -- Within 150 kilometers (150,000 meters) AND ( -- Calculate the angular difference between the hotel's azimuth from the start_geom and the target_azimuth -- LEAST handles the 0/360 degree wrap-around for angular distance LEAST( ABS(degrees(ST_Azimuth(ac.start_geom, p.geometry)) - ac.target_azimuth), 360 - ABS(degrees(ST_Azimuth(ac.start_geom, p.geometry)) - ac.target_azimuth) ) <= 22.5 -- Filter for hotels within +/- 22.5 degrees of the target direction (a compass octant) ) ORDER BY ST_Distance(p.geometry::geography, ac.start_geom::geography) ASC;",
