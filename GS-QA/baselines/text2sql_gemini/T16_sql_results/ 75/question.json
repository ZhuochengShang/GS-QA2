{
  "question": "Where is restaurant situated within 60 kilometers in the direction of Ascension Medical Group, St. Johns, FL from Eddy Lookout Tower, Sanderson, FL?",
  "sql": "WITH start_location AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Eddy Lookout Tower%' AND addr_city ILIKE '%Sanderson%' AND addr_state ILIKE '%FL%' LIMIT 1 ), target_location AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Ascension Medical Group%' AND addr_city ILIKE '%St. Johns%' AND addr_state ILIKE '%FL%' LIMIT 1 ), direction_data AS ( SELECT (SELECT geometry FROM start_location) AS start_geom, degrees(ST_Azimuth((SELECT geometry FROM start_location), (SELECT geometry FROM target_location))) AS target_bearing ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, direction_data AS dd WHERE p.amenity = 'restaurant' AND ST_DWithin(p.geometry::geography, dd.start_geom::geography, 60000) -- within 60 kilometers (60000 meters) AND ( LEAST( ABS(degrees(ST_Azimuth(dd.start_geom, p.geometry)) - dd.target_bearing), 360 - ABS(degrees(ST_Azimuth(dd.start_geom, p.geometry)) - dd.target_bearing) ) <= 22.5 -- within a 45-degree cone (+/- 22.5 degrees) of the target bearing );",
