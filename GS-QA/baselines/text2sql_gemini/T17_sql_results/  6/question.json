  "question": "Where can I find the nearest restaurant nearby Jakes Rock Overlook and Mountain Bike Trail, Tidioute, PA?",
  "sql": "SELECT P.poi_name, P.addr_state, P.addr_city, ST_Distance( P.geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Jakes Rock Overlook and Mountain Bike Trail%' AND addr_city ILIKE '%Tidioute%' AND addr_state ILIKE '%PA%' LIMIT 1 )::geography ) AS distance_meters FROM pois AS P WHERE P.amenity = 'restaurant' ORDER BY P.geometry <-> ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Jakes Rock Overlook and Mountain Bike Trail%' AND addr_city ILIKE '%Tidioute%' AND addr_state ILIKE '%PA%' LIMIT 1 ) LIMIT 1;",
