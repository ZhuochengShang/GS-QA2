  "question": "Where can I find the closest golf course to Shechem Ministries, Lawrenceburg, KY?",
  "sql": "WITH shechem_location AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Shechem Ministries%' AND addr_city ILIKE '%Lawrenceburg%' AND addr_state ILIKE '%KY%' LIMIT 1 ), golf_courses AS ( SELECT poi_name AS name, geometry FROM pois WHERE leisure = 'golf_course' UNION ALL SELECT park_name AS name, geometry FROM parks WHERE leisure = 'golf_course' ) SELECT gc.name FROM golf_courses AS gc, shechem_location AS sl ORDER BY ST_Distance(gc.geometry::geography, sl.geometry::geography) ASC LIMIT 1;",
