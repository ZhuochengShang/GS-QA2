  "question": "Where’s the nearest aquarium located toward the east of the George Washington University - Arlington Education Center, Arlington, VA?",
  "sql": "SELECT poi_name, addr_state, addr_city FROM pois AS P WHERE P.tourism = 'aquarium' AND DEGREES(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%George Washington University - Arlington Education Center%' AND addr_city ILIKE '%Arlington%' AND addr_state ILIKE '%VA%' LIMIT 1), P.geometry )) BETWEEN 67.5 AND 112.5 ORDER BY (SELECT geometry FROM pois WHERE poi_name ILIKE '%George Washington University - Arlington Education Center%' AND addr_city ILIKE '%Arlington%' AND addr_state ILIKE '%VA%' LIMIT 1)::geography <-> P.geometry::geography LIMIT 1;",
