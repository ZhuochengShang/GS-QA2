{
  "question": "Where is the closest hospital relative to the north of Tree That Owns Itself, Athens, GA?",
  "sql": "WITH reference_point AS ( SELECT geometry AS ref_geom FROM pois WHERE poi_name ILIKE '%Tree That Owns Itself%' AND addr_city ILIKE '%Athens%' AND addr_state ILIKE '%GA%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, reference_point AS rp WHERE p.amenity = 'hospital' AND ( degrees(ST_Azimuth(rp.ref_geom, p.geometry)) BETWEEN 0 AND 22.5 OR degrees(ST_Azimuth(rp.ref_geom, p.geometry)) BETWEEN 337.5 AND 360 ) ORDER BY ST_Distance(rp.ref_geom::geography, p.geometry::geography) ASC LIMIT 1;",
