{
  "question": "Where is the nearest museum as you go west from Carson Park Stadium, Eau Claire, WI?",
  "sql": "SELECT pois.poi_name, ST_Distance(pois.geometry::geography, stadium_location.stadium_geom::geography) AS distance_meters FROM pois, ( SELECT geometry AS stadium_geom FROM pois WHERE poi_name ILIKE '%Carson Park Stadium%' AND addr_city ILIKE '%Eau Claire%' AND addr_state ILIKE '%WI%' LIMIT 1 ) AS stadium_location WHERE pois.tourism = 'museum' AND degrees(ST_Azimuth(stadium_location.stadium_geom, pois.geometry)) BETWEEN 247.5 AND 292.5 ORDER BY ST_Distance(pois.geometry::geography, stadium_location.stadium_geom::geography) ASC LIMIT 1;",
