  "question": "Where’s the closest aquarium when heading southeast from Oswald's Bear Ranch, Newberry, MI?",
  "sql": "SELECT aquarium.poi_name, aquarium.addr_state, aquarium.addr_city FROM pois AS aquarium WHERE aquarium.tourism = 'aquarium' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Oswald''s Bear Ranch%' AND addr_city ILIKE '%Newberry%' AND addr_state ILIKE '%MI%' LIMIT 1 ), aquarium.geometry )) BETWEEN 112.5 AND 157.5 ORDER BY ST_Distance( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Oswald''s Bear Ranch%' AND addr_city ILIKE '%Newberry%' AND addr_state ILIKE '%MI%' LIMIT 1 )::geography, aquarium.geometry::geography ) ASC LIMIT 1;",
