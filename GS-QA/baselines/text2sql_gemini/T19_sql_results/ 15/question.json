  "question": "Where’s the closest attraction relative to Hall des Lumières, New York, NY in the northwest direction?",
  "sql": "WITH hall_des_lumieres_geom AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Hall des Lumières%' AND addr_city ILIKE '%New York%' AND addr_state ILIKE '%NY%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city, p.amenity, p.leisure, p.tourism, p.cuisine, p.museum, p.healthcare, p.takeaway, p.drive_through, p.outdoor_seating, p.emergency, p.restaurant FROM pois AS p, hall_des_lumieres_geom AS hdl WHERE p.tourism = 'attraction' AND degrees(ST_Azimuth(hdl.geometry, p.geometry)) BETWEEN 292.5 AND 337.5 -- Northwest direction ORDER BY hdl.geometry <-> p.geometry LIMIT 1;",
