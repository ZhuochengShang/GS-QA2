  "question": "Where’s the closest hospital on the path going northwest from Hotel AKA Boston Common, Boston, MA?",
  "sql": "WITH hotel_location AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Hotel AKA Boston Common%' AND addr_city ILIKE '%Boston%' AND addr_state ILIKE '%MA%' LIMIT 1 ) SELECT p.id, p.poi_name FROM pois AS p, hotel_location AS hl WHERE p.amenity = 'hospital' AND hl.geometry IS NOT NULL AND ( degrees(ST_Azimuth(hl.geometry, p.geometry)) BETWEEN 292.5 AND 337.5 ) ORDER BY ST_Distance(hl.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
