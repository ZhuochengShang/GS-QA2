  "question": "Where can I find the closest aquarium toward the northeast of Karpeles Manuscript Library, Jacksonville, FL?",
  "sql": "SELECT p.poi_name FROM pois AS p, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Karpeles Manuscript Library%' AND addr_city ILIKE '%Jacksonville%' AND addr_state ILIKE '%FL%' LIMIT 1 ) AS origin WHERE p.tourism = 'aquarium' AND degrees(ST_Azimuth(origin.geometry, p.geometry)) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance(origin.geometry::geography, p.geometry::geography) LIMIT 1;",
