  "question": "Where is the nearest attraction in the direction of west from the Grove, Washington, DC?",
  "sql": "SELECT p.poi_name FROM pois AS p, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%The Grove%' AND addr_city ILIKE '%Washington%' AND addr_state ILIKE '%DC%' LIMIT 1 ) AS grove_location WHERE p.tourism = 'attraction' AND degrees(ST_Azimuth(grove_location.geometry, p.geometry)) BETWEEN 247.5 AND 292.5 ORDER BY ST_Distance(grove_location.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
