  "question": "Where’s the nearest hotel that lies northeast of Cox Science Center and Aquarium, West Palm Beach, FL?",
  "sql": "WITH reference_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Cox Science Center and Aquarium%' AND addr_city ILIKE '%West Palm Beach%' AND addr_state ILIKE '%FL%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, reference_point AS rp WHERE p.tourism = 'hotel' AND degrees(ST_Azimuth(rp.geometry, p.geometry)) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance(p.geometry::geography, rp.geometry::geography) ASC LIMIT 1;",
