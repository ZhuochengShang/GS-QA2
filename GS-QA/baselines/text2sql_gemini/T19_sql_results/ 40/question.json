  "question": "Where’s the closest café in the southeast direction from Sawgrass Lake Park, Saint Petersburg, FL?",
  "sql": "WITH SawgrassLakePark AS ( SELECT geometry FROM parks WHERE park_name ILIKE '%Sawgrass Lake Park%' LIMIT 1 ) SELECT p.poi_name FROM pois p, SawgrassLakePark slp WHERE p.amenity = 'cafe' AND degrees(ST_Azimuth(slp.geometry, p.geometry)) BETWEEN 112.5 AND 157.5 -- Southeast direction ORDER BY ST_Distance(slp.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
