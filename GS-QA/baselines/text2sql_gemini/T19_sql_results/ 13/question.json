{
  "question": "Where is the closest museum situated on the southeast side of Our Lady of the Rivers Shrine, Portage Des Sioux, MO?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Our Lady of the Rivers Shrine%' AND addr_city ILIKE '%Portage Des Sioux%' AND addr_state ILIKE '%MO%' LIMIT 1 ) AS shrine WHERE p.tourism = 'museum' AND degrees(ST_Azimuth(shrine.geometry::geography, p.geometry::geography)) BETWEEN 112.5 AND 157.5 ORDER BY ST_Distance(shrine.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
