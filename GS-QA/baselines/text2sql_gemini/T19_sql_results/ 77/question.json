{
  "question": "Where’s the closest stadium found toward the north of Illinois Central Depot, Bethany, IL?",
  "sql": "WITH origin AS ( SELECT geometry AS origin_geom FROM pois WHERE poi_name ILIKE '%Illinois Central Depot%' AND addr_city ILIKE '%Bethany%' AND addr_state ILIKE '%IL%' LIMIT 1 ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, origin AS o WHERE p.leisure = 'stadium' AND ( degrees(ST_Azimuth(o.origin_geom, p.geometry)) BETWEEN 337.5 AND 360 OR degrees(ST_Azimuth(o.origin_geom, p.geometry)) BETWEEN 0 AND 22.5 ) ORDER BY p.geometry <-> o.origin_geom LIMIT 1;",
