  "question": "Where’s the nearest restaurant heading west from Residence Inn, Los Angeles, CA?",
  "sql": "SELECT poi_name FROM pois WHERE amenity = 'restaurant' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Residence Inn%' AND addr_city ILIKE '%Los Angeles%' AND addr_state ILIKE '%CA%' LIMIT 1 ), geometry )) BETWEEN 247.5 AND 292.5 ORDER BY ST_Distance( geometry, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Residence Inn%' AND addr_city ILIKE '%Los Angeles%' AND addr_state ILIKE '%CA%' LIMIT 1 ) ) LIMIT 1;",
