  "question": "Where is the nearest café along the northeast direction from Freedom Fields, Bossier City, LA?",
  "sql": "SELECT poi_name, addr_state, addr_city FROM pois WHERE amenity = 'cafe' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Freedom Fields%' AND addr_city ILIKE '%Bossier City%' AND addr_state ILIKE '%LA%' LIMIT 1), geometry )) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Freedom Fields%' AND addr_city ILIKE '%Bossier City%' AND addr_state ILIKE '%LA%' LIMIT 1)::geography, geometry::geography ) ASC LIMIT 1;",
