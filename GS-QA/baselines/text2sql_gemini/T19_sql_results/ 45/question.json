  "question": "Where’s the closest fast food restaurant going north from City Suites Hotel, Chicago, IL?",
  "sql": "WITH origin AS ( SELECT geometry AS origin_geom FROM pois WHERE poi_name ILIKE '%City Suites Hotel%' AND addr_city ILIKE '%Chicago%' AND addr_state ILIKE '%IL%' LIMIT 1 ) SELECT p.poi_name, p.addr_city, p.addr_state FROM pois AS p, origin AS o WHERE p.amenity = 'fast_food' AND ST_DWithin(p.geometry::geography, o.origin_geom::geography, 50000) -- Search within 50km radius for efficiency AND ( degrees(ST_Azimuth(o.origin_geom, p.geometry)) BETWEEN 0 AND 22.5 OR degrees(ST_Azimuth(o.origin_geom, p.geometry)) BETWEEN 337.5 AND 360 ) ORDER BY o.origin_geom <-> p.geometry LIMIT 1;",
