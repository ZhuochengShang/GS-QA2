  "question": "Where is the nearest zoo if you move northwest from the Lake House, East Springfield, PA?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p WHERE p.tourism = 'zoo' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Lake House%' AND addr_city ILIKE '%East Springfield%' AND addr_state ILIKE '%PA%' LIMIT 1), p.geometry )) BETWEEN 292.5 AND 337.5 -- Northwest direction ORDER BY ST_Distance( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Lake House%' AND addr_city ILIKE '%East Springfield%' AND addr_state ILIKE '%PA%' LIMIT 1)::geography, p.geometry::geography ) ASC LIMIT 1;",
