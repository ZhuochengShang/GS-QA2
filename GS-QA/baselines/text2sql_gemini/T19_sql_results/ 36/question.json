  "question": "Where’s the closest fast food restaurant found toward the south of Rockford Career College, Rockford, IL?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p WHERE p.amenity = 'fast_food' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Rockford Career College%' AND addr_city ILIKE '%Rockford%' AND addr_state ILIKE '%IL%' LIMIT 1), p.geometry )) BETWEEN 157.5 AND 202.5 ORDER BY ST_Distance( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Rockford Career College%' AND addr_city ILIKE '%Rockford%' AND addr_state ILIKE '%IL%' LIMIT 1)::geography, p.geometry::geography ) ASC LIMIT 1;",
