  "question": "Where can I find the nearest café to the southwest of Glenwood Caverns Adventure Park, Glenwood Springs, CO?",
  "sql": "WITH park_location AS ( SELECT geometry AS geom FROM pois WHERE poi_name ILIKE '%Glenwood Caverns Adventure Park%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city, p.amenity FROM pois AS p, park_location AS pl WHERE p.amenity = 'cafe' AND degrees(ST_Azimuth(pl.geom, p.geometry)) BETWEEN 202.5 AND 247.5 -- Southwest direction ORDER BY ST_Distance(pl.geom::geography, p.geometry::geography) LIMIT 1;",
