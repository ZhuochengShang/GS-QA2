  "question": "Where’s the closest café when heading west from Taswira, Seattle, WA?",
  "sql": "SELECT p.poi_name FROM pois AS p, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Taswira%' AND addr_city ILIKE '%Seattle%' AND addr_state ILIKE '%WA%' LIMIT 1 ) AS origin WHERE p.amenity = 'cafe' AND degrees(ST_Azimuth(origin.geometry, p.geometry)) BETWEEN 247.5 AND 292.5 ORDER BY ST_Distance(origin.geometry::geography, p.geometry::geography) LIMIT 1;",
