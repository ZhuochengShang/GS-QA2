  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE tourism = 'zoo' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%CUNY School of Professional Studies%' AND addr_city ILIKE '%New York%' AND addr_state ILIKE '%NY%' LIMIT 1 ), geometry )) BETWEEN 67.5 AND 112.5 ORDER BY geometry <-> ( SELECT geometry FROM pois WHERE poi_name ILIKE '%CUNY School of Professional Studies%' AND addr_city ILIKE '%New York%' AND addr_state ILIKE '%NY%' LIMIT 1 ) LIMIT 1;",
