  "question": "Where can I find the nearest hotel to the southwest of Lindenwood University, Belleville, IL?",
  "sql": "SELECT poi_name, addr_state, addr_city FROM pois WHERE tourism = 'hotel' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Lindenwood University%' AND addr_city ILIKE '%Belleville%' AND addr_state ILIKE '%IL%' LIMIT 1), geometry )) BETWEEN 202.5 AND 247.5 ORDER BY ST_Distance( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Lindenwood University%' AND addr_city ILIKE '%Belleville%' AND addr_state ILIKE '%IL%' LIMIT 1)::geography, geometry::geography ) ASC LIMIT 1;",
