  "question": "Where is the nearest museum if you move northwest from Point Lookout, PA?",
  "sql": "SELECT pois.poi_name, pois.addr_state, pois.addr_city FROM pois WHERE pois.tourism = 'museum' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Point Lookout%' AND addr_state ILIKE '%PA%' LIMIT 1 ), pois.geometry )) BETWEEN 292.5 AND 337.5 ORDER BY ST_Distance( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Point Lookout%' AND addr_state ILIKE '%PA%' LIMIT 1 )::geography, pois.geometry::geography ) ASC LIMIT 1;",
