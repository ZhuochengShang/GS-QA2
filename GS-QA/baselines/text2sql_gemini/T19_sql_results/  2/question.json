  "question": "Where’s the closest golf course lying in the east direction of UniSea Inn, Dutch Harbor, AK?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p WHERE p.leisure = 'golf_course' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%UniSea Inn%' AND addr_city ILIKE '%Dutch Harbor%' AND addr_state ILIKE '%AK%' LIMIT 1), p.geometry )) BETWEEN 67.5 AND 112.5 ORDER BY (SELECT geometry FROM pois WHERE poi_name ILIKE '%UniSea Inn%' AND addr_city ILIKE '%Dutch Harbor%' AND addr_state ILIKE '%AK%' LIMIT 1) <-> p.geometry LIMIT 1;",
