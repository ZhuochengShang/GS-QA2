  "question": "Where is the closest hospital relative to the northeast of McDonald Farm, Naperville, IL?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p WHERE p.amenity = 'hospital' AND degrees(ST_Azimuth( ST_Centroid((SELECT geometry FROM pois WHERE poi_name ILIKE '%McDonald Farm%' AND addr_city ILIKE '%Naperville%' AND addr_state ILIKE '%IL%' LIMIT 1)), ST_Centroid(p.geometry) )) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance( ST_Centroid((SELECT geometry FROM pois WHERE poi_name ILIKE '%McDonald Farm%' AND addr_city ILIKE '%Naperville%' AND addr_state ILIKE '%IL%' LIMIT 1))::geography, ST_Centroid(p.geometry)::geography ) ASC LIMIT 1;",
