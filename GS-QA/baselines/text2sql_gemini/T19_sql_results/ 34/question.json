  "question": "Where’s the closest fast food restaurant in the northeastward direction from Concordia University Wisconsin-Beloit Center, Beloit, WI?",
  "sql": "SELECT poi_name, addr_state, addr_city, amenity FROM pois WHERE amenity = 'fast_food' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Concordia University Wisconsin-Beloit Center%' AND addr_city ILIKE '%Beloit%' AND addr_state ILIKE '%WI%' LIMIT 1 ), geometry )) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Concordia University Wisconsin-Beloit Center%' AND addr_city ILIKE '%Beloit%' AND addr_state ILIKE '%WI%' LIMIT 1 ) :: geography, geometry :: geography ) ASC LIMIT 1;",
