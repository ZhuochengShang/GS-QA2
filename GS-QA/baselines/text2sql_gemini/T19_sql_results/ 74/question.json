  "question": "Where is the nearest gallery in the direction of northwest from Blue Ocean Discovery Center, Hampton, NH?",
  "sql": "SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Blue Ocean Discovery Center%' AND addr_city ILIKE '%Hampton%' AND addr_state ILIKE '%NH%' LIMIT 1 ) AS origin WHERE p.tourism = 'gallery' AND degrees(ST_Azimuth(origin.geometry::geography, p.geometry::geography)) BETWEEN 292.5 AND 337.5 ORDER BY ST_Distance(origin.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
