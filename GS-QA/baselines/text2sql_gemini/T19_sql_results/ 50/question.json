  "sql": "SELECT id, poi_name, addr_state, addr_city, amenity, cuisine FROM pois WHERE amenity = 'restaurant' AND degrees(ST_Azimuth( ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Lonely Red Caboose%' AND addr_city ILIKE '%Wabash%' AND addr_state ILIKE '%IN%' LIMIT 1 ), pois.geometry )) BETWEEN 202.5 AND 247.5 ORDER BY pois.geometry <-> ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Lonely Red Caboose%' AND addr_city ILIKE '%Wabash%' AND addr_state ILIKE '%IN%' LIMIT 1 ) LIMIT 1;",
