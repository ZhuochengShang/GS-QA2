  "question": "Where’s the closest fast food restaurant in relation to WORKS/San José, San Jose, CA along the west direction?",
  "sql": "WITH reference_poi AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%WORKS/San José%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, reference_poi AS rp WHERE p.amenity = 'fast_food' AND degrees(ST_Azimuth(rp.geometry::geography, p.geometry::geography)) BETWEEN 247.5 AND 292.5 -- West direction ORDER BY rp.geometry::geography <-> p.geometry::geography LIMIT 1;",
