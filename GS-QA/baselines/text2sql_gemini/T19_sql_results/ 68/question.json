  "question": "Where is the nearest restaurant found on the south side of Out of Africa Wildlife Park, Camp Verde, AZ?",
  "sql": "WITH park_location AS ( SELECT geometry AS park_geom, ST_Centroid(geometry) AS park_centroid FROM pois WHERE poi_name ILIKE '%Out of Africa Wildlife Park%' AND addr_city ILIKE '%Camp Verde%' AND addr_state ILIKE '%AZ%' LIMIT 1 ) SELECT p.poi_name, p.addr_state, p.addr_city FROM pois AS p, park_location AS pl WHERE p.amenity = 'restaurant' -- Filter for restaurants whose centroid is geographically south of the park's centroid AND degrees(ST_Azimuth(pl.park_centroid, ST_Centroid(p.geometry))) BETWEEN 157.5 AND 202.5 ORDER BY p.geometry <-> pl.park_centroid LIMIT 1;",
