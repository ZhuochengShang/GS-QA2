  "question": "Where is the nearest stadium toward the west side starting from Adventure Park, Scottsdale, AZ?",
  "sql": "WITH start_point AS ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Adventure Park%' AND addr_city ILIKE '%Scottsdale%' AND addr_state ILIKE '%AZ%' LIMIT 1 ) SELECT p.poi_name FROM pois p, start_point sp WHERE sp.geometry IS NOT NULL AND p.leisure = 'stadium' AND degrees(ST_Azimuth(sp.geometry, p.geometry)) BETWEEN 247.5 AND 292.5 -- Filter for west direction ORDER BY ST_Distance(sp.geometry::geography, p.geometry::geography) ASC LIMIT 1;",
