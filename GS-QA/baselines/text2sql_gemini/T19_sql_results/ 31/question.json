  "question": "Where is the closest university situated on the northeast side of Mentor Civic Arena, Mentor, OH?",
  "sql": "SELECT poi_name, addr_state, addr_city FROM pois WHERE amenity = 'university' AND degrees(ST_Azimuth( ST_Centroid((SELECT geometry FROM pois WHERE poi_name ILIKE '%Mentor Civic Arena%' AND addr_city ILIKE '%Mentor%' AND addr_state ILIKE '%OH%' LIMIT 1)), ST_Centroid(geometry) )) BETWEEN 22.5 AND 67.5 ORDER BY ST_Distance( geometry::geography, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Mentor Civic Arena%' AND addr_city ILIKE '%Mentor%' AND addr_state ILIKE '%OH%' LIMIT 1)::geography ) LIMIT 1;",
