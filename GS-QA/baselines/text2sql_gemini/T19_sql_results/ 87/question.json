  "question": "Where is the nearest gallery along the east direction from Easton Hospital, Easton, PA?",
  "sql": "SELECT P.poi_name, P.addr_city, P.addr_state FROM pois AS P WHERE P.tourism ILIKE '%gallery%' AND degrees(ST_Azimuth( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Easton Hospital%' AND addr_city ILIKE '%Easton%' AND addr_state ILIKE '%PA%' LIMIT 1), P.geometry )) BETWEEN 67.5 AND 112.5 ORDER BY ST_Distance( (SELECT geometry FROM pois WHERE poi_name ILIKE '%Easton Hospital%' AND addr_city ILIKE '%Easton%' AND addr_state ILIKE '%PA%' LIMIT 1)::geography, P.geometry::geography ) ASC LIMIT 1;",
