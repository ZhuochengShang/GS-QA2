  "question": "Can you point me to a beach resort within 160 kilometers from Hendry Regional Convenient Care Center, LaBelle, FL?",
  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE (tourism = 'hotel' OR tourism = 'resort') AND (poi_name ILIKE '%beach%' OR poi_name ILIKE '%resort%') AND ST_DWithin( geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Hendry Regional Convenient Care Center%' AND addr_city ILIKE '%LaBelle%' AND addr_state ILIKE '%FL%' LIMIT 1 )::geography, 160 * 1000 );",
