{
  "question": "Where can I find a golf course within a 50 kilometers distance of Art Clinic, New York, NY?",
  "sql": "SELECT poi_name FROM pois WHERE leisure = 'golf_course' AND ST_DWithin( geometry::geography, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Art Clinic%' AND addr_city ILIKE '%New York%' AND addr_state ILIKE '%NY%' LIMIT 1)::geography, 50000 ) UNION ALL SELECT park_name FROM parks WHERE leisure = 'golf_course' AND ST_DWithin( geometry::geography, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Art Clinic%' AND addr_city ILIKE '%New York%' AND addr_state ILIKE '%NY%' LIMIT 1)::geography, 50000 );",
