  "question": "Where is a hospital located within 130 kilometers of Stratton Fire Tower, Stratton, Vermont?",
  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE amenity = 'hospital' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Stratton Fire Tower%' AND addr_city ILIKE '%Stratton%' AND addr_state ILIKE '%Vermont%' LIMIT 1 ), 130000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Stratton Fire Tower%' AND addr_city ILIKE '%Stratton%' AND addr_state ILIKE '%Vermont%' LIMIT 1 )) ASC;",
