{
  "question": "Where can I find a golf course inside 80 kilometers from Popcorn Park Animal Refuge, Forked River, NJ?",
  "sql": "SELECT poi_name FROM pois WHERE leisure = 'golf_course' AND ST_DWithin(geometry::geography, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Popcorn Park Animal Refuge%' AND addr_city ILIKE '%Forked River%' AND addr_state ILIKE '%NJ%' LIMIT 1)::geography, 80000) UNION SELECT park_name FROM parks WHERE leisure = 'golf_course' AND ST_DWithin(geometry::geography, (SELECT geometry FROM pois WHERE poi_name ILIKE '%Popcorn Park Animal Refuge%' AND addr_city ILIKE '%Forked River%' AND addr_state ILIKE '%NJ%' LIMIT 1)::geography, 80000);",
