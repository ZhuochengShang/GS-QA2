  "question": "Where might I find a indian restaurant within 70 kilometers from Barrett, the Honors College at ASU, Tempe, AZ?",
  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE cuisine ILIKE '%indian%' AND amenity = 'restaurant' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Barrett, the Honors College at ASU%' AND addr_city ILIKE '%Tempe%' AND addr_state ILIKE '%AZ%' LIMIT 1 ), 70000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Barrett, the Honors College at ASU%' AND addr_city ILIKE '%Tempe%' AND addr_state ILIKE '%AZ%' LIMIT 1 )) ASC;",
