  "question": "Where are an emergency hospital available within 190 kilometers from Tree That Owns Itself, Athens, GA?",
  "sql": "SELECT poi_name, addr_state, addr_city FROM pois WHERE amenity = 'hospital' AND emergency = 'yes' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Tree That Owns Itself%' AND addr_city ILIKE '%Athens%' AND addr_state ILIKE '%GA%' LIMIT 1 ), 190000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Tree That Owns Itself%' AND addr_city ILIKE '%Athens%' AND addr_state ILIKE '%GA%' LIMIT 1 )) ASC;",
