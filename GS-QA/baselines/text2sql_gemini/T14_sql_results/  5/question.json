  "question": "Where can I find a mediterranean restaurant within a 90 kilometers proximity of Queen Street Gallery, Martinsburg, WV?",
  "sql": "SELECT id, poi_name, addr_city, addr_state FROM pois WHERE cuisine ILIKE '%mediterranean%' AND amenity = 'restaurant' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Queen Street Gallery%' AND addr_city ILIKE '%Martinsburg%' AND addr_state ILIKE '%WV%' LIMIT 1 ), 90000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Queen Street Gallery%' AND addr_city ILIKE '%Martinsburg%' AND addr_state ILIKE '%WV%' LIMIT 1 )) ASC;",
