  "question": "Can you retrieve an emergency hospital within 190 kilometers from Butterfield Garage Art Gallery, Saint Augustine, FL?",
  "sql": "SELECT poi_name, addr_state, addr_city, amenity, healthcare, emergency FROM pois WHERE amenity = 'hospital' AND emergency = 'yes' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Butterfield Garage Art Gallery%' AND addr_city ILIKE '%Saint Augustine%' AND addr_state ILIKE '%FL%' LIMIT 1 ), 190000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Butterfield Garage Art Gallery%' AND addr_city ILIKE '%Saint Augustine%' AND addr_state ILIKE '%FL%' LIMIT 1 )) ASC;",
