  "question": "Can you help locate an emergency hospital inside an 80 kilometers range of Magness Arena, CO?",
  "sql": "SELECT poi_name, addr_city, addr_state FROM pois WHERE amenity = 'hospital' AND emergency = 'yes' AND ST_DWithin(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Magness Arena%' LIMIT 1 ), 80000) ORDER BY ST_Distance(geometry::geography, ( SELECT geometry::geography FROM pois WHERE poi_name ILIKE '%Magness Arena%' LIMIT 1 )) ASC;",
