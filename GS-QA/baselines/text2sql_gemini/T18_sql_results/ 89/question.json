  "question": "Where is the nearest emergency hospital located relative to Elyria Arts Council, Elyria, OH?",
  "sql": "SELECT poi_name, ST_Distance( P.geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Elyria Arts Council%' AND addr_city ILIKE '%Elyria%' AND addr_state ILIKE '%OH%' LIMIT 1 )::geography ) AS distance_meters FROM pois AS P WHERE P.amenity = 'hospital' AND P.emergency = 'yes' ORDER BY P.geometry <-> ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Elyria Arts Council%' AND addr_city ILIKE '%Elyria%' AND addr_state ILIKE '%OH%' LIMIT 1 ) LIMIT 1;",
