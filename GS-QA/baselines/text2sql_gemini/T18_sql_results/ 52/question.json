  "question": "Where is the nearest emergency hospital located relative to Stonehedge Gardens, Tamaqua, PA?",
  "sql": "SELECT P.poi_name, P.addr_city, P.addr_state, ST_Distance(P.geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Stonehedge Gardens%' AND addr_city ILIKE '%Tamaqua%' AND addr_state ILIKE '%PA%' LIMIT 1 )::geography) AS distance_meters FROM pois AS P WHERE P.amenity = 'hospital' AND P.emergency = 'yes' ORDER BY P.geometry::geography <-> ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Stonehedge Gardens%' AND addr_city ILIKE '%Tamaqua%' AND addr_state ILIKE '%PA%' LIMIT 1 )::geography LIMIT 1;",
