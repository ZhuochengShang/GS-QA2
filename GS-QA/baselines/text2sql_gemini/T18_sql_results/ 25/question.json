  "question": "Where is the nearest restaurant with outdoor seating located relative to Sea Life Aquarium, Auburn Hills, MI?",
  "sql": "SELECT p.poi_name, ST_Distance(p.geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Sea Life Aquarium%' AND addr_city ILIKE '%Auburn Hills%' AND addr_state ILIKE '%MI%' LIMIT 1 )::geography) AS distance_meters FROM pois AS p WHERE p.amenity = 'restaurant' AND p.outdoor_seating = 'yes' ORDER BY ST_Distance(p.geometry::geography, ( SELECT geometry FROM pois WHERE poi_name ILIKE '%Sea Life Aquarium%' AND addr_city ILIKE '%Auburn Hills%' AND addr_state ILIKE '%MI%' LIMIT 1 )::geography) LIMIT 1;",
