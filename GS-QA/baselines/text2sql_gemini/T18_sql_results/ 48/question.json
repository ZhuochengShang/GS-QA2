  "question": "Where can I find the nearest local museum in the vicinity of Victory Park, Minden, LA?",
  "sql": "SELECT poi_name FROM pois WHERE tourism = 'museum' OR museum = 'yes' ORDER BY ST_Distance( pois.geometry::geography, ( SELECT P.geometry FROM parks AS P WHERE P.park_name ILIKE '%Victory Park%' AND ST_Intersects( P.geometry, (SELECT R.geometry FROM regions AS R WHERE R.region_name ILIKE '%Minden%' AND R.border_type = 'city' LIMIT 1)::geography ) LIMIT 1 )::geography ) LIMIT 1;",
