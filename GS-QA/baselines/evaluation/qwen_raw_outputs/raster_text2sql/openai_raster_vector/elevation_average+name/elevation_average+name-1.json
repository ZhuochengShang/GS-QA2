  "model_output": "```sql\nWITH restaurant_geom AS (\n  SELECT \n    ST_SetSRID(ST_GeomFromText('POINT (-73.910743 41.413255)'), 4326)::geometry AS geom\n),\ndem_clip AS (\n  SELECT \n    ST_Union(rast) AS rast\n  FROM \n    public.dem_us\n  WHERE \n    ST_Intersects(\n      rast, \n      ST_Envelope(restaurant_geom.geom)\n    )\n),\navg_elevation AS (\n  SELECT \n    ST_ValueCount(rast, 1) AS count,\n    ST_Sum(ST_Band(rast, 1)) AS total_elevation\n  FROM \n    dem_clip\n),\nrestaurant_elevation AS (\n  SELECT \n    ST_Union(ST_Clip(dem_clip.rast, true, restaurant_geom.geom)) AS clipped_rast\n  FROM \n    dem_clip, restaurant_geom\n),\nrestaurant_stats AS (\n  SELECT \n    ST_Sum(ST_Band(clipped_rast, 1)) / ST_ValueCount(clipped_rast, 1) AS restaurant_avg_elevation\n  FROM \n    restaurant_elevation\n),\nfinal_stats AS (\n  SELECT \n    (total_elevation / count) AS dem_avg_elevation,\n    restaurant_avg_elevation\n  FROM \n    avg_elevation, restaurant_stats\n)\nSELECT \n  'CLOSED - The Bird & Bottle Inn' AS poi_name,\n  CASE \n    WHEN restaurant_avg_elevation > dem_avg_elevation THEN 'above average elevation'\n    ELSE 'not above average elevation'\n  END AS elevation_status\nFROM \n  final_stats;\n```",
