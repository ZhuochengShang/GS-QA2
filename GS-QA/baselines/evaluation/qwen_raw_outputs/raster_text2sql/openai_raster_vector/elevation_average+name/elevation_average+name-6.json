  "model_output": "```sql\nWITH park_geom AS (\n  SELECT \n    ST_SetSRID(ST_MakePoint(-102.120752, 31.962885), 4326)::geography AS geometry\n),\nmidland_boundary AS (\n  SELECT \n    geometry\n  FROM \n    regions\n  WHERE \n    region_name ILIKE 'Midland' \n    AND addr_state ILIKE 'TX'\n),\ndem_clip AS (\n  SELECT \n    ST_Clip(rast, (park_geom.geometry::geometry), true) AS clipped_rast\n  FROM \n    public.dem_us, park_geom\n  WHERE \n    ST_Intersects(rast, park_geom.geometry::geometry)\n),\npark_elevation_stats AS (\n  SELECT \n    ST_ValueCount(clipped_rast, true) AS elevation_stats\n  FROM \n    dem_clip\n),\npark_avg_elevation AS (\n  SELECT \n    (elevation_stats).sum::float / (elevation_stats).count AS avg_elevation\n  FROM \n    park_elevation_stats\n),\ndem_midland_clip AS (\n  SELECT \n    ST_Clip(rast, (midland_boundary.geometry::geometry), true) AS clipped_rast\n  FROM \n    public.dem_us, midland_boundary\n  WHERE \n    ST_Intersects(rast, midland_boundary.geometry::geometry)\n),\nmidland_elevation_stats AS (\n  SELECT \n    ST_ValueCount(clipped_rast, true) AS elevation_stats\n  FROM \n    dem_midland_clip\n),\nmidland_avg_elevation AS (\n  SELECT \n    (elevation_stats).sum::float / (elevation_stats).count AS avg_elevation\n  FROM \n    midland_elevation_stats\n)\nSELECT \n  'I-20 Wildlife Preserve' AS park_name,\n  (SELECT avg_elevation FROM park_avg_elevation) AS park_avg_elevation,\n  (SELECT avg_elevation FROM midland_avg_elevation) AS midland_avg_elevation\nWHERE \n  (SELECT avg_elevation FROM park_avg_elevation) > (SELECT avg_elevation FROM midland_avg_elevation);\n```",
