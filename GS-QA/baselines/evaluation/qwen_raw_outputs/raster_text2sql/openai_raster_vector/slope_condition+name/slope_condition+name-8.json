  "id": "slope_condition+name-8",
  "model_output": "```sql\nWITH cb5_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM regions\n  WHERE region_name ILIKE 'Manhattan Community Board 5'\n),\nslope_raster AS (\n  SELECT \n    ST_Slope(rast, 1, '32BF') AS slope_rast\n  FROM public.dem_us\n  WHERE ST_Intersects(rast, (SELECT geom FROM cb5_geom))\n),\nslope_clip AS (\n  SELECT \n    ST_Clip(slope_rast, (SELECT geom FROM cb5_geom), true) AS clipped_slope\n  FROM slope_raster\n),\nrestaurants_in_cb5 AS (\n  SELECT \n    pois.id,\n    pois.poi_name,\n    pois.geometry::geometry AS geom\n  FROM pois\n  WHERE pois.amenity = 'restaurant'\n    AND pois.addr_city = 'New York'\n    AND pois.addr_state = 'NY'\n    AND ST_Contains((SELECT geom FROM cb5_geom), pois.geometry::geometry)\n),\nslope_analysis AS (\n  SELECT \n    r.id,\n    r.poi_name,\n    ST_Value(s.clipped_slope, r.geom) AS slope_degrees\n  FROM restaurants_in_cb5 r\n  CROSS JOIN slope_clip s\n  WHERE ST_Intersects(s.clipped_slope, r.geom)\n)\nSELECT \n  poi_name\nFROM slope_analysis\nWHERE slope_degrees > 43;\n```",
