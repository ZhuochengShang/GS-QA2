  "predicted_sql": "WITH wilton_region AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Wilton'\n    AND border_type = 'city'\n    AND ST_GeometryType(geometry) = 'ST_Polygon'\n  LIMIT 1\n),\nbiggest_park_in_wilton AS (\n  SELECT p.park_name, p.geometry\n  FROM parks p\n  JOIN wilton_region w ON ST_Within(p.geometry, w.geometry)\n  ORDER BY ST_Area(p.geometry) DESC\n  LIMIT 1\n),\npark_clipped_dem AS (\n  SELECT\n    ST_Clip(\n      r.rast,\n      1,\n      b.geometry,\n      TRUE\n    ) AS clipped_rast\n  FROM biggest_park_in_wilton b\n  CROSS JOIN public.dem_us r\n  WHERE ST_Intersects(r.rast::geometry, b.geometry)\n),\nmax_elevation AS (\n  SELECT\n    MAX((v).val) AS max_elevation\n  FROM park_clipped_dem c,\n    LATERAL ST_DumpAsPoints(clipped_rast) AS v\n)\nSELECT\n  b.park_name,\n  m.max_elevation\nFROM biggest_park_in_wilton b\nCROSS JOIN max_elevation m;",
