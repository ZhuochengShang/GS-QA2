  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-95.993858 36.152229)',4326)::geography, 4000)\n  AND p.amenity = 'cafe'\n  AND elev.z >= 160;",
  "id": "range+name+elevation_condition-7",
  "model_output": "```sql\nWITH target_poi AS (\n  SELECT \n    ST_SetSRID(ST_MakePoint(-95.993858, 36.152229), 4326)::geography AS geom\n),\nbuffered_area AS (\n  SELECT \n    ST_Buffer(geom, 4000) AS geom\n  FROM target_poi\n),\ncafe_candidates AS (\n  SELECT \n    id,\n    poi_name,\n    ST_Distance(geom::geometry, (SELECT geom::geometry FROM buffered_area)) AS distance_meters\n  FROM pois\n  WHERE \n    amenity = 'cafe' AND\n    ST_DWithin(geom::geometry, (SELECT geom::geometry FROM buffered_area), 4000)\n),\nelevation_check AS (\n  SELECT \n    cc.id,\n    cc.poi_name,\n    ST_Value(r.rast, ST_Transform(cc.geom, 4326)) AS elevation\n  FROM cafe_candidates cc\n  JOIN public.dem_us r ON ST_Intersects(r.rast, ST_Transform(cc.geom, 4326))\n)\nSELECT \n  poi_name\nFROM elevation_check\nWHERE elevation >= 160;\n```",
