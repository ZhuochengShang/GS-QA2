  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-111.96187 41.237122)',4326)::geography, 4400)\n  AND p.leisure = 'park'\n  AND elev.z >= 240;",
  "id": "range+name+elevation_condition-1",
  "model_output": "```sql\nWITH stadium_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM pois\n  WHERE poi_name ILIKE 'Pioneer Stadium' AND addr_city ILIKE 'Ogden' AND addr_state ILIKE 'UT'\n),\nparks_within_distance AS (\n  SELECT p.park_name, p.geometry::geometry AS geom\n  FROM parks p\n  WHERE ST_DWithin(p.geometry::geometry, (SELECT geom FROM stadium_geom), 4400)\n    AND p.addr_state ILIKE 'UT'\n),\nelevation_check AS (\n  SELECT \n    park_name,\n    ST_Value(r.rast, p.geom) AS elevation\n  FROM parks_within_distance p\n  JOIN public.dem_us r ON ST_Intersects(r.rast, p.geom)\n  WHERE ST_Value(r.rast, p.geom) >= 240\n)\nSELECT park_name\nFROM elevation_check;\n```",
