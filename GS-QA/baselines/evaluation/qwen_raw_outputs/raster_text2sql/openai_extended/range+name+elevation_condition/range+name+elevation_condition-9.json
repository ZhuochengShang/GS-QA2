  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-87.627512 41.888424)',4326)::geography, 4100)\n  AND p.tourism = 'attraction'\n  AND elev.z >= 80;",
  "id": "range+name+elevation_condition-9",
  "model_output": "```sql\nWITH langham_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM pois\n  WHERE poi_name ILIKE 'The Langham, Chicago'\n    AND addr_city = 'Chicago'\n    AND addr_state = 'IL'\n),\nbuffered_area AS (\n  SELECT ST_Buffer(geom, 4100) AS geom\n  FROM langham_geom\n),\nelevation_clip AS (\n  SELECT\n    ST_Union(rast) AS rast\n  FROM\n    public.dem_us\n  WHERE\n    ST_Intersects(rast, (SELECT geom FROM buffered_area))\n),\nelevation_values AS (\n  SELECT\n    (ST_SummaryStats(ST_Clip(rast, (SELECT geom FROM buffered_area), TRUE))).*\n  FROM\n    elevation_clip\n)\nSELECT\n  'The Langham, Chicago, Chicago, IL' AS reference,\n  (SELECT geom FROM langham_geom) AS reference_geom,\n  (SELECT geom FROM buffered_area) AS buffer_geom,\n  count AS num_pixels,\n  sum AS total_elevation,\n  mean AS avg_elevation,\n  CASE\n    WHEN mean >= 80 THEN 'Yes'\n    ELSE 'No'\n  END AS elevation_condition_met\nFROM\n  elevation_values;\n```",
