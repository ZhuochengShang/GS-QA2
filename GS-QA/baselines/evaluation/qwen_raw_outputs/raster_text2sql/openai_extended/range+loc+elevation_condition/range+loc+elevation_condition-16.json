  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-104.677049 38.270312)',4326)::geography, 4900)\n  AND p.amenity = 'fast_food'\n  AND elev.z >= 340;",
  "id": "range+loc+elevation_condition-16",
  "model_output": "```sql\nWITH center_point AS (\n  SELECT \n    ST_SetSRID(ST_GeomFromText('POINT (-104.677049 38.270312)'), 4326)::geography AS geom\n),\nfast_food_candidates AS (\n  SELECT \n    p.poi_name,\n    p.geometry\n  FROM \n    pois p\n  WHERE \n    p.amenity = 'fast_food' AND\n    ST_DWithin(p.geometry::geography, (SELECT geom FROM center_point), 4900)\n),\nelevation_check AS (\n  SELECT \n    f.poi_name,\n    f.geometry,\n    (ST_Value(public.dem_us.rast, f.geometry::geometry, true)) AS elevation\n  FROM \n    fast_food_candidates f\n  JOIN \n    public.dem_us\n  ON \n    ST_Intersects(public.dem_us.rast, f.geometry::geometry)\n  WHERE \n    (ST_Value(public.dem_us.rast, f.geometry::geometry, true)) >= 340\n)\nSELECT \n  poi_name\nFROM \n  elevation_check;\n```",
