  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-111.93162 33.496042)',4326)::geography, 1900)\n  AND p.amenity = 'fast_food'\n  AND elev.z >= 60;",
  "id": "range+loc+elevation_condition-17",
  "model_output": "```sql\nWITH travelodge_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM pois\n  WHERE poi_name ILIKE 'Travelodge Scottsdale' AND addr_city = 'Scottsdale' AND addr_state = 'AZ'\n),\nfast_food_candidates AS (\n  SELECT \n    p.poi_name,\n    p.geometry::geometry AS geom,\n    ST_Distance(p.geometry::geography, (SELECT geom FROM travelodge_geom)) AS distance_meters\n  FROM pois p\n  WHERE p.amenity = 'fast_food' \n    AND ST_DWithin(p.geometry::geography, (SELECT geom FROM travelodge_geom), 1900)\n),\nelevation_analysis AS (\n  SELECT \n    f.poi_name,\n    f.geom,\n    f.distance_meters,\n    (ST_Value(r.rast, 1, f.geom))::numeric AS elevation_m\n  FROM fast_food_candidates f\n  JOIN public.dem_us r ON ST_Intersects(r.rast, f.geom)\n)\nSELECT \n  poi_name,\n  elevation_m\nFROM elevation_analysis\nWHERE elevation_m >= 60;\n```",
