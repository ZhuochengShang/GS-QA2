  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-108.603856 39.09253)',4326)::geography, 2000)\n  AND p.amenity = 'cafe'\n  AND elev.z >= 260;",
  "id": "range+loc+elevation_condition-10",
  "model_output": "```sql\nWITH childrens_nature_center AS (\n  SELECT geometry\n  FROM pois\n  WHERE poi_name ILIKE 'Childrens''s Nature Center'\n    AND addr_city = 'Grand Junction'\n    AND addr_state = 'CO'\n),\nbuffered_area AS (\n  SELECT ST_Buffer(geometry::geometry, 2000) AS geom\n  FROM childrens_nature_center\n),\nclipped_dem AS (\n  SELECT ST_Clip(rast, true, (SELECT geom FROM buffered_area)) AS rast\n  FROM public.dem_us\n  WHERE ST_Intersects(rast, (SELECT geom FROM buffered_area))\n),\ncafe_candidates AS (\n  SELECT p.poi_name, p.geometry\n  FROM pois p\n  WHERE p.amenity = 'cafe'\n    AND ST_DWithin(p.geometry::geometry, (SELECT geom FROM buffered_area), 0)\n    AND ST_Value((SELECT rast FROM clipped_dem), p.geometry::geometry) >= 260\n)\nSELECT poi_name\nFROM cafe_candidates;\n```",
