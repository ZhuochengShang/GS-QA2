  "gold_sql": "SELECT\n  p.*,\n  ST_Distance(\n    ST_GeomFromText('POINT (-85.909866 41.628033)',4326)::geography,\n    p.geometry::geography\n  ) AS distance,\n  elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(\n        p.geometry::geography,\n        ST_GeomFromText('POINT (-85.909866 41.628033)',4326)::geography,\n        3600\n      )\n  AND amenity = 'fast_food';",
  "id": "range+distance+elevation-6",
  "model_output": "```sql\nWITH starbucks_geom AS (\n  SELECT ST_SetSRID(ST_MakePoint(-85.909866, 41.628033), 4326)::geography AS geom\n),\nfast_food_restaurant_geom AS (\n  SELECT ST_SetSRID(ST_MakePoint(-74.116887, 40.665788), 4326)::geography AS geom\n)\nSELECT\n  ST_Distance(starbucks_geom.geom, fast_food_restaurant_geom.geom) AS distance_meters,\n  (ST_Value(r.rast, 1, ST_Transform(fast_food_restaurant_geom.geom, 4326)::geometry)) AS elevation_meters\nFROM\n  starbucks_geom,\n  fast_food_restaurant_geom,\n  public.dem_us r\nWHERE\n  ST_Intersects(r.rast, ST_Transform(fast_food_restaurant_geom.geom, 4326)::geometry);\n```",
