  "model_output": "```sql\nWITH bay_lake_florida AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Bay Lake' AND addr_state ILIKE 'FL'\n),\nhotels_in_bay_lake AS (\n  SELECT pois.id, pois.geometry\n  FROM pois\n  JOIN bay_lake_florida\n    ON ST_Intersects(pois.geometry::geometry, bay_lake_florida.geometry::geometry)\n  WHERE pois.tourism = 'hotel'\n),\nrestaurants_in_bay_lake AS (\n  SELECT pois.id, pois.geometry\n  FROM pois\n  JOIN bay_lake_florida\n    ON ST_Intersects(pois.geometry::geometry, bay_lake_florida.geometry::geometry)\n  WHERE pois.amenity = 'restaurant'\n),\nhotel_elevations AS (\n  SELECT\n    h.id,\n    ST_Value(\n      ST_Clip(public.dem_us.rast, true, h.geometry::geometry),\n      1,\n      ST_Centroid(h.geometry::geometry)\n    ) AS elevation\n  FROM hotels_in_bay_lake h\n  JOIN public.dem_us\n    ON ST_Intersects(public.dem_us.rast, h.geometry::geometry)\n),\nrestaurant_elevations AS (\n  SELECT\n    r.id,\n    ST_Value(\n      ST_Clip(public.dem_us.rast, true, r.geometry::geometry),\n      1,\n      ST_Centroid(r.geometry::geometry)\n    ) AS elevation\n  FROM restaurants_in_bay_lake r\n  JOIN public.dem_us\n    ON ST_Intersects(public.dem_us.rast, r.geometry::geometry)\n)\nSELECT\n  'hotels' AS category,\n  AVG(elevation) AS avg_elevation\nFROM hotel_elevations\nUNION ALL\nSELECT\n  'restaurants' AS category,\n  AVG(elevation) AS avg_elevation\nFROM restaurant_elevations\nORDER BY avg_elevation DESC\nLIMIT 1;\n```",
