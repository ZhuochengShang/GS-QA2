  "model_output": "```sql\nWITH nelson_county AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Nelson County'\n    AND border_type = 'county'\n    AND addr_state = 'KY'\n),\nattractions AS (\n  SELECT pois.id, pois.geometry\n  FROM pois\n  WHERE pois.tourism = 'attraction'\n    AND pois.addr_state = 'KY'\n    AND ST_Within(pois.geometry::geometry, (SELECT geometry FROM nelson_county))\n),\ngolf_courses AS (\n  SELECT pois.id, pois.geometry\n  FROM pois\n  WHERE pois.leisure = 'golf_course'\n    AND pois.addr_state = 'KY'\n    AND ST_Within(pois.geometry::geometry, (SELECT geometry FROM nelson_county))\n),\nattraction_elevations AS (\n  SELECT\n    ST_Value(rast, ST_Centroid(attractions.geometry::geometry)) AS elevation\n  FROM\n    public.dem_us,\n    attractions\n  WHERE\n    ST_Intersects(rast, attractions.geometry::geometry)\n),\ngolf_course_elevations AS (\n  SELECT\n    ST_Value(rast, ST_Centroid(golf_courses.geometry::geometry)) AS elevation\n  FROM\n    public.dem_us,\n    golf_courses\n  WHERE\n    ST_Intersects(rast, golf_courses.geometry::geometry)\n)\nSELECT\n  'attractions' AS category,\n  AVG(elevation) AS avg_elevation\nFROM\n  attraction_elevations\nUNION ALL\nSELECT\n  'golf_courses' AS category,\n  AVG(elevation) AS avg_elevation\nFROM\n  golf_course_elevations\nORDER BY\n  avg_elevation DESC\nLIMIT 1;\n```",
