  "model_output": "```sql\nWITH zoo_geoms AS (\n  SELECT \n    'The Farm at Walnut Creek, Sugarcreek, OH'::text AS zoo_name,\n    ST_SetSRID(ST_GeomFromText('POINT (-81.737201 40.522778)'), 4326)::geography AS geom\n  UNION ALL\n  SELECT \n    regions.region_name || ', Holmes County, OH'::text AS zoo_name,\n    regions.geometry AS geom\n  FROM regions\n  WHERE regions.region_name ILIKE '%zoo%' \n    AND regions.addr_state = 'OH'\n    AND regions.addr_county = 'Holmes'\n    AND regions.border_type = 'municipal'\n),\nzoo_slope AS (\n  SELECT \n    zoo_geoms.zoo_name,\n    ST_Slope(\n      ST_Clip(\n        public.dem_us.rast, \n        true, \n        zoo_geoms.geom::geometry\n      ), \n      1\n    ) AS slope_rast\n  FROM zoo_geoms\n  JOIN public.dem_us ON ST_Intersects(public.dem_us.rast, zoo_geoms.geom::geometry)\n),\nzoo_slope_stats AS (\n  SELECT \n    zoo_name,\n    ROUND(AVG(ST_Value(slope_rast, 1)) * 100, 2) AS avg_slope_percent\n  FROM zoo_slope\n  GROUP BY zoo_name\n)\nSELECT \n  zoo_name,\n  avg_slope_percent\nFROM zoo_slope_stats\nORDER BY avg_slope_percent DESC\nLIMIT 3;\n```",
