  "id": "elevation_compare_categories+name-0",
  "model_output": "```sql\nWITH manhattan_cb5 AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name = 'Manhattan Community Board 5'\n    AND border_type = 'community_board'\n    AND wikipedia ILIKE '%manhattan%'\n),\ngalleries AS (\n  SELECT pois.geometry\n  FROM pois\n  WHERE tourism = 'gallery'\n    AND ST_Contains((SELECT geometry::geometry FROM manhattan_cb5), pois.geometry::geometry)\n),\nviewpoints AS (\n  SELECT pois.geometry\n  FROM pois\n  WHERE tourism = 'viewpoint'\n    AND ST_Contains((SELECT geometry::geometry FROM manhattan_cb5), pois.geometry::geometry)\n),\ngallery_elevations AS (\n  SELECT ST_Value(rast, pois.geometry::geometry) AS elevation\n  FROM public.dem_us\n  CROSS JOIN galleries AS pois\n  WHERE ST_Intersects(rast, pois.geometry::geometry)\n),\nviewpoint_elevations AS (\n  SELECT ST_Value(rast, pois.geometry::geometry) AS elevation\n  FROM public.dem_us\n  CROSS JOIN viewpoints AS pois\n  WHERE ST_Intersects(rast, pois.geometry::geometry)\n)\nSELECT \n  COALESCE(\n    CASE \n      WHEN avg(gallery_elevations.elevation) > avg(viewpoint_elevations.elevation) THEN 'galleries'\n      WHEN avg(gallery_elevations.elevation) < avg(viewpoint_elevations.elevation) THEN 'viewpoints'\n      ELSE 'equal'\n    END,\n    'no data'\n  ) AS higher_category,\n  avg(gallery_elevations.elevation) AS avg_gallery_elevation,\n  avg(viewpoint_elevations.elevation) AS avg_viewpoint_elevation\nFROM gallery_elevations, viewpoint_elevations;\n```",
