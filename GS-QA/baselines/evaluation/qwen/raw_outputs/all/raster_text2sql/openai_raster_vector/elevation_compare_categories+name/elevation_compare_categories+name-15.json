  "model_output": "```sql\nWITH watauga_county AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Watauga County' AND border_type = 'county'\n),\ngolf_courses AS (\n  SELECT pois.id, pois.geometry\n  FROM pois\n  JOIN watauga_county\n    ON ST_Intersects(pois.geometry::geometry, watauga_county.geometry::geometry)\n  WHERE pois.leisure = 'golf_course'\n),\nparks AS (\n  SELECT parks.id, parks.geometry\n  FROM parks\n  JOIN watauga_county\n    ON ST_Intersects(parks.geometry::geometry, watauga_county.geometry::geometry)\n  WHERE parks.leisure = 'park'\n),\ngolf_course_elevations AS (\n  SELECT\n    ST_ValueCount(\n      ST_Clip(\n        r.rast,\n        geometry::geometry,\n        TRUE\n      ),\n      TRUE\n    ) AS elevation_stats\n  FROM golf_courses\n  CROSS JOIN public.dem_us r\n  WHERE ST_Intersects(r.rast, geometry::geometry)\n),\npark_elevations AS (\n  SELECT\n    ST_ValueCount(\n      ST_Clip(\n        r.rast,\n        geometry::geometry,\n        TRUE\n      ),\n      TRUE\n    ) AS elevation_stats\n  FROM parks\n  CROSS JOIN public.dem_us r\n  WHERE ST_Intersects(r.rast, geometry::geometry)\n),\ngolf_avg AS (\n  SELECT\n    (sum(elevation_stats.sum) / sum(elevation_stats.count))::numeric AS avg_elevation\n  FROM golf_course_elevations,\n    LATERAL json_to_record(elevation_stats) AS t(sum double precision, count double precision)\n),\npark_avg AS (\n  SELECT\n    (sum(elevation_stats.sum) / sum(elevation_stats.count))::numeric AS avg_elevation\n  FROM park_elevations,\n    LATERAL json_to_record(elevation_stats) AS t(sum double precision, count double precision)\n),\ncomparison AS (\n  SELECT\n    'golf_courses' AS category,\n    avg_elevation\n  FROM golf_avg\n  UNION ALL\n  SELECT\n    'parks' AS category,\n    avg_elevation\n  FROM park_avg\n),\nwinner AS (\n  SELECT\n    category,\n    avg_elevation,\n    RANK() OVER (ORDER BY avg_elevation DESC) AS rank\n  FROM comparison\n)\nSELECT\n  category\nFROM winner\nWHERE rank = 1;\n```",
