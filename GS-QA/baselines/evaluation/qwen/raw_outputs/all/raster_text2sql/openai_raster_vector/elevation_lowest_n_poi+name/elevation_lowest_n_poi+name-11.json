  "gold_sql": "WITH region AS (\n  SELECT ST_GeomFromText('POLYGON ((-100.235668 31.692921, -100.234585 31.581369, -100.17172 31.581106, -100.11105 31.580548, -100.112478 31.439054, -100.11338 31.297468, -100.113598 31.250211, -100.114882 31.150169, -100.115307 31.088036, -100.304936 31.088458, -100.500979 31.087606, -100.68846 31.086404, -100.688951 31.135754, -100.689983 31.239186, -100.691352 31.383803, -100.692594 31.465556, -100.692659 31.486291, -100.69314 31.523969, -100.879839 31.526322, -100.981287 31.527429, -100.998294 31.527593, -101.049054 31.527712, -101.201391 31.528537, -101.267917 31.528738, -101.267559 31.556286, -101.136634 31.558341, -101.001012 31.56047, -100.865251 31.562331, -100.863527 31.634907, -100.862432 31.663814, -100.861124 31.70541, -100.856273 31.704146, -100.845992 31.701464, -100.841708 31.700346, -100.83954 31.699781, -100.83463 31.6985, -100.829552 31.697176, -100.82532 31.696072, -100.824729 31.696065, -100.822038 31.696035, -100.658447 31.694222, -100.489493 31.693359, -100.43502 31.693033, -100.31732 31.692736, -100.235668 31.692921))', 4326) AS g\n),\ncandidates AS (\n  SELECT p.*, ST_PointOnSurface(p.geometry::geometry) AS pt\n  FROM pois p\n  JOIN region r ON ST_Intersects(p.geometry::geometry, r.g)\n  WHERE p.\"leisure\" = 'park'\n),\npoi_elev AS (\n  SELECT c.*, elev.z AS elevation\n  FROM candidates c\n  JOIN LATERAL (\n    SELECT ST_Value(d.rast, 1, c.pt) AS z\n    FROM public.dem_us d\n    WHERE ST_Intersects(d.rast, c.pt)\n    LIMIT 1\n  ) elev ON elev.z IS NOT NULL\n)\nSELECT *\nFROM poi_elev\nORDER BY elevation ASC\nLIMIT 3;",
  "id": "elevation_lowest_n_poi+name-11",
  "model_output": "```sql\nWITH tom_green_county AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Tom Green County'\n    AND border_type = 'county'\n    AND addr_state = 'TX'\n),\nparks_in_county AS (\n  SELECT p.geometry\n  FROM parks p, tom_green_county tgc\n  WHERE ST_Intersects(p.geometry::geometry, tgc.geometry::geometry)\n),\nraster_analysis AS (\n  SELECT\n    ST_Union(ST_Clip(public.dem_us.rast, parks_in_county.geometry::geometry, TRUE)) AS clipped_rast\n  FROM\n    public.dem_us, parks_in_county\n  WHERE\n    ST_Intersects(public.dem_us.rast, parks_in_county.geometry::geometry)\n),\nelevation_stats AS (\n  SELECT\n    (ST_SummaryStats(clipped_rast, 1, TRUE)).*\n  FROM\n    raster_analysis\n)\nSELECT\n  'Tom Green County' AS county,\n  (SELECT MIN(val) FROM (SELECT (ST_PixelAsValues(clipped_rast, 1)).val FROM raster_analysis) AS vals) AS lowest_elevation\nFROM\n  elevation_stats\nLIMIT 3;\n```",
