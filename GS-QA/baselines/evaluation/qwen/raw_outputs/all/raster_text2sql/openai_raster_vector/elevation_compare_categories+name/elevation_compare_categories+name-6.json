  "model_output": "```sql\nWITH pinellas_county AS (\n  SELECT geometry\n  FROM regions\n  WHERE region_name ILIKE 'Pinellas County'\n    AND border_type = 'county'\n    AND addr_state = 'FL'\n),\ngolf_courses AS (\n  SELECT ST_Clip(public.dem_us.rast, true) AS rast\n  FROM pois\n  JOIN public.dem_us ON ST_Intersects(public.dem_us.rast::geometry, pois.geometry::geometry)\n  WHERE pois.addr_city = 'Saint Petersburg'\n    AND pois.addr_state = 'FL'\n    AND pois.poi_name = 'Sawgrass Lake Park'\n    AND pois.leisure = 'golf_course'\n),\nparks AS (\n  SELECT ST_Clip(public.dem_us.rast, true) AS rast\n  FROM pois\n  JOIN public.dem_us ON ST_Intersects(public.dem_us.rast::geometry, pois.geometry::geometry)\n  WHERE pois.addr_city = 'Saint Petersburg'\n    AND pois.addr_state = 'FL'\n    AND pois.poi_name = 'Sawgrass Lake Park'\n    AND pois.leisure = 'park'\n),\ngolf_avg_elevation AS (\n  SELECT ST_ValueCount(rast, true) AS stats\n  FROM golf_courses\n),\npark_avg_elevation AS (\n  SELECT ST_ValueCount(rast, true) AS stats\n  FROM parks\n)\nSELECT\n  'golf course' AS category,\n  (golf_avg_elevation.stats).sum * 1.0 / (golf_avg_elevation.stats).count AS avg_elevation\nFROM golf_avg_elevation\nUNION ALL\nSELECT\n  'park' AS category,\n  (park_avg_elevation.stats).sum * 1.0 / (park_avg_elevation.stats).count AS avg_elevation\nFROM park_avg_elevation;\n```",
