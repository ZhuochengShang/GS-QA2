  "gold_sql": "WITH region AS (\n  SELECT ST_GeomFromText('POLYGON ((-84.046618 44.083792, -84.04732 44.112764, -84.047277 44.126997, -84.047358 44.161801, -84.032142 44.161925, -84.024956 44.161896, -84.017348 44.161936, -84.012425 44.161944, -84.004771 44.161906, -83.978871 44.161921, -83.967332 44.16189, -83.95901 44.161864, -83.927506 44.161772, -83.92706 44.083946, -84.046618 44.083792))', 4326) AS g\n),\nclipped AS (\n  SELECT ST_Clip(d.rast, r.g) AS rast\n  FROM public.dem_us d\n  JOIN region r\n    ON ST_Intersects(d.rast, r.g)\n)\nSELECT (ST_SummaryStats(ST_Union(rast))).mean AS elevation\nFROM clipped;",
