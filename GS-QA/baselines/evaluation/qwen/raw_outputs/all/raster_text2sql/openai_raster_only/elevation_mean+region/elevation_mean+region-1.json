  "gold_sql": "WITH region AS (\n  SELECT ST_GeomFromText('POLYGON ((-72.871136 42.484041, -72.87516 42.507261, -72.87032 42.52515, -72.875462 42.525898, -72.876658 42.531734, -72.87685 42.541198, -72.975409 42.556037, -72.979036 42.541618, -72.968583 42.540012, -72.979282 42.497856, -72.896902 42.48328, -72.892814 42.482556, -72.882245 42.480686, -72.871136 42.484041))', 4326) AS g\n),\nclipped AS (\n  SELECT ST_Clip(d.rast, r.g) AS rast\n  FROM public.dem_us d\n  JOIN region r\n    ON ST_Intersects(d.rast, r.g)\n)\nSELECT (ST_SummaryStats(ST_Union(rast))).mean AS elevation\nFROM clipped;",
