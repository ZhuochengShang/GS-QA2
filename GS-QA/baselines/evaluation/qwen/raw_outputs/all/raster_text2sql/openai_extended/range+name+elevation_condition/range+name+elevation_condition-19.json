  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, 500)\n  AND p.amenity = 'restaurant'\n  AND elev.z >= 80;",
  "id": "range+name+elevation_condition-19",
  "model_output": "```sql\nWITH target_poi AS (\n  SELECT ST_SetSRID(ST_GeomFromText('POINT (-97.715155 30.344507)'), 4326)::geometry AS geom\n),\ncandidate_poi AS (\n  SELECT ST_SetSRID(ST_GeomFromText('POINT (-71.201964 44.096829)'), 4326)::geometry AS geom\n),\nbuffered_area AS (\n  SELECT ST_Buffer(target_poi.geom, 500) AS geom\n  FROM target_poi\n),\ndem_clip AS (\n  SELECT\n    ST_Union(rast) AS rast\n  FROM\n    public.dem_us\n  WHERE\n    ST_Intersects(rast, (SELECT geom FROM buffered_area))\n),\nelevation_stats AS (\n  SELECT\n    ST_Value(rast, candidate_poi.geom) AS elevation\n  FROM\n    dem_clip,\n    candidate_poi\n)\nSELECT\n  CASE\n    WHEN elevation >= 80 THEN 'Yes'\n    ELSE 'No'\n  END AS answer,\n  elevation\nFROM\n  elevation_stats;\n```",
