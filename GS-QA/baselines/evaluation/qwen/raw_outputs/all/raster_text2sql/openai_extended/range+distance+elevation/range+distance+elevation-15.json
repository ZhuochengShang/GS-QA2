  "gold_sql": "SELECT\n  p.*,\n  ST_Distance(\n    ST_GeomFromText('POINT (-122.683571 45.529567)',4326)::geography,\n    p.geometry::geography\n  ) AS distance,\n  elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(\n        p.geometry::geography,\n        ST_GeomFromText('POINT (-122.683571 45.529567)',4326)::geography,\n        3400\n      )\n  AND tourism = 'attraction';",
  "id": "range+distance+elevation-15",
  "model_output": "```sql\nWITH willamette_uni AS (\n  SELECT ST_SetSRID(ST_MakePoint(-122.683571, 45.529567), 4326)::geography AS geom\n),\nattraction AS (\n  SELECT ST_SetSRID(ST_MakePoint(-77.02832, 38.900025), 4326)::geography AS geom\n),\ndistance_result AS (\n  SELECT ST_Distance(willamette_uni.geom, attraction.geom) AS distance_meters\n  FROM willamette_uni, attraction\n),\nelevation_result AS (\n  SELECT \n    ST_Value(\n      ST_Union(r.rast), \n      ST_SetSRID(ST_MakePoint(-77.02832, 38.900025), 4326)\n    ) AS elevation_meters\n  FROM public.dem_us r\n  WHERE ST_Intersects(\n    r.rast, \n    ST_SetSRID(ST_MakePoint(-77.02832, 38.900025), 4326)\n  )\n)\nSELECT \n  distance_result.distance_meters,\n  elevation_result.elevation_meters\nFROM distance_result, elevation_result;\n```",
