  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-102.120752 31.962885)',4326)::geography, 3600)\n  AND p.tourism = 'attraction'\n  AND elev.z >= 400;",
  "id": "range+name+elevation_condition-13",
  "model_output": "```sql\nWITH preserve_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM pois\n  WHERE poi_name ILIKE 'I-20 Wildlife Preserve'\n    AND addr_city ILIKE 'Midland'\n    AND addr_state ILIKE 'TX'\n),\nbuffered_area AS (\n  SELECT ST_Buffer(geom, 3600) AS geom\n  FROM preserve_geom\n),\nclipped_dem AS (\n  SELECT ST_Clip(rast, true, (SELECT geom FROM buffered_area)) AS rast\n  FROM public.dem_us\n  WHERE ST_Intersects(rast, (SELECT geom FROM buffered_area))\n),\nelevation_values AS (\n  SELECT (ST_SummaryStats(rast, 1)).*\n  FROM clipped_dem\n),\nfiltered_attractions AS (\n  SELECT p.poi_name, p.geometry AS geom\n  FROM pois p\n  WHERE p.poi_name ILIKE '%attraction%'\n    AND ST_DWithin(p.geometry::geometry, (SELECT geom FROM preserve_geom), 3600)\n    AND ST_Value(\n      (SELECT rast FROM clipped_dem LIMIT 1),\n      p.geometry::geometry\n    ) >= 400\n)\nSELECT * FROM filtered_attractions;\n```",
