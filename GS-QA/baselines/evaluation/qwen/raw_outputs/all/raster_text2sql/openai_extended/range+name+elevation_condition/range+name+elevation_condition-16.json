  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-111.920729 33.631545)',4326)::geography, 4700)\n  AND p.tourism = 'hotel'\n  AND elev.z >= 220;",
  "id": "range+name+elevation_condition-16",
  "model_output": "```sql\nWITH target_poi AS (\n  SELECT\n    ST_SetSRID(ST_GeomFromText('POINT (-111.920729 33.631545)'), 4326)::geometry AS geom\n),\nbuffered_area AS (\n  SELECT\n    ST_Buffer(target_poi.geom, 4700) AS geom\n  FROM\n    target_poi\n),\nclipped_dem AS (\n  SELECT\n    ST_Clip(rast, 1, buffered_area.geom, true) AS rast\n  FROM\n    public.dem_us,\n    buffered_area\n  WHERE\n    ST_Intersects(rast, buffered_area.geom)\n),\nelevation_stats AS (\n  SELECT\n    ST_ValueCount(clipped_dem.rast, true) AS elevation_count\n  FROM\n    clipped_dem\n)\nSELECT\n  'Prince Conti Hotel, New Orleans, LA' AS suggestion,\n  (SELECT MIN(elevation_count.value) FROM (SELECT (elevation_count).*) AS elevation_count WHERE (elevation_count).value >= 220) AS min_elevation\nFROM\n  elevation_stats;\n```",
