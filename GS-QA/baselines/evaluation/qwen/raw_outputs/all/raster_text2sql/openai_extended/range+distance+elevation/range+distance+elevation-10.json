  "gold_sql": "SELECT\n  p.*,\n  ST_Distance(\n    ST_GeomFromText('POINT (-122.409877 37.797336)',4326)::geography,\n    p.geometry::geography\n  ) AS distance,\n  elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(\n        p.geometry::geography,\n        ST_GeomFromText('POINT (-122.409877 37.797336)',4326)::geography,\n        4400\n      )\n  AND leisure = 'park';",
  "id": "range+distance+elevation-10",
  "model_output": "```sql\nWITH taishan_point AS (\n  SELECT ST_SetSRID(ST_MakePoint(-122.409877, 37.797336), 4326)::geography AS geom\n),\npark_point AS (\n  SELECT ST_SetSRID(ST_MakePoint(-85.117643, 32.520492), 4326)::geography AS geom\n),\nbuffered_area AS (\n  SELECT ST_Buffer(taishan_point.geom, 4400) AS geom\n  FROM taishan_point\n),\nclipped_dem AS (\n  SELECT ST_Clip(r.rast, ST_Transform(buffered_area.geom, 4326)::geometry) AS rast\n  FROM public.dem_us r, buffered_area\n  WHERE ST_Intersects(ST_Transform(r.rast, 4326)::geometry, ST_Transform(buffered_area.geom, 4326)::geometry)\n),\nelevation_stats AS (\n  SELECT (ST_DumpAsPolygons(clipped_dem.rast, 1, TRUE)).val AS elevation\n  FROM clipped_dem\n)\nSELECT \n  ST_Distance(taishan_point.geom, park_point.geom) AS distance_meters,\n  ROUND(AVG(elevation_stats.elevation)) AS average_elevation\nFROM taishan_point, park_point, elevation_stats;\n```",
