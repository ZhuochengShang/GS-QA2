  "gold_sql": "SELECT\n  p.*,\n  ST_Distance(\n    ST_GeomFromText('POINT (-96.726608 43.5456)',4326)::geography,\n    p.geometry::geography\n  ) AS distance,\n  elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(\n        p.geometry::geography,\n        ST_GeomFromText('POINT (-96.726608 43.5456)',4326)::geography,\n        3700\n      )\n  AND leisure = 'park';",
  "id": "range+distance+elevation-0",
  "model_output": "```sql\nWITH park_point AS (\n  SELECT \n    ST_SetSRID(ST_GeomFromText('[1][\"geo_wkt\"]'), 4326)::geography AS geom\n), \npoi_point AS (\n  SELECT \n    ST_SetSRID(ST_GeomFromText('[3][\"geo_wkt\"]'), 4326)::geography AS geom\n),\ndistance_result AS (\n  SELECT \n    ST_Distance(poi_point.geom, park_point.geom) AS distance_meters\n  FROM \n    park_point, poi_point\n),\nelevation_result AS (\n  SELECT \n    ST_Value(r.rast, p.geom::geometry) AS elevation\n  FROM \n    public.dem_us r,\n    park_point p\n  WHERE \n    ST_Intersects(r.rast, p.geom::geometry)\n    AND ST_Distance(p.geom::geography, park_point.geom) <= 3700\n)\nSELECT \n  distance_result.distance_meters,\n  elevation_result.elevation\nFROM \n  distance_result, elevation_result;\n```",
