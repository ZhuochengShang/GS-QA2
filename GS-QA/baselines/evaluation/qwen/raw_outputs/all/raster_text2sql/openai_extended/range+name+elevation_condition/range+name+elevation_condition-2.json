  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-86.874042 33.494874)',4326)::geography, 4900)\n  AND p.amenity = 'restaurant'\n  AND elev.z >= 20;",
  "id": "range+name+elevation_condition-2",
  "model_output": "```sql\nWITH arena_location AS (\n  SELECT ST_SetSRID(ST_MakePoint(-86.874042, 33.494874), 4326)::geography AS geom\n),\nbuffered_area AS (\n  SELECT ST_Buffer(geom, 4900) AS geom\n  FROM arena_location\n),\nelevation_clip AS (\n  SELECT ST_Clip(rast, ST_Transform(geom, 4326), true) AS clipped_rast\n  FROM public.dem_us, buffered_area\n  WHERE ST_Intersects(rast, ST_Transform(geom, 4326))\n),\nelevation_stats AS (\n  SELECT ST_ValueCount(clipped_rast, true) AS stats\n  FROM elevation_clip\n),\nmin_elevation AS (\n  SELECT (stats).min_val AS min_elevation\n  FROM elevation_stats\n),\nrestaurant_location AS (\n  SELECT ST_SetSRID(ST_MakePoint(-96.773019, 43.506918), 4326)::geography AS geom\n),\nrestaurant_elevation AS (\n  SELECT ST_Value(rast, ST_Transform(geom, 4326)) AS elevation\n  FROM public.dem_us, restaurant_location\n  WHERE ST_Intersects(rast, ST_Transform(geom, 4326))\n)\nSELECT \n  'PizzaRev, Sioux Falls, SD' AS restaurant_name,\n  elevation\nFROM restaurant_elevation, min_elevation\nWHERE elevation >= 20;\n```",
