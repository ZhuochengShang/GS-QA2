  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-96.7287 43.551472)',4326)::geography, 2300)\n  AND p.amenity = 'cafe'\n  AND elev.z >= 380;",
  "id": "range+name+elevation_condition-11",
  "model_output": "```sql\nWITH museum_geom AS (\n  SELECT geometry::geometry AS geom\n  FROM pois\n  WHERE poi_name ILIKE 'Old Courthouse Museum'\n    AND addr_city ILIKE 'Sioux Falls'\n    AND addr_state ILIKE 'SD'\n),\ncafe_candidates AS (\n  SELECT \n    p.poi_name,\n    p.geometry::geometry AS geom\n  FROM pois p\n  JOIN museum_geom m ON ST_DWithin(p.geometry::geometry, m.geom, 2300)\n  WHERE p.amenity ILIKE 'cafe'\n    AND p.addr_city ILIKE 'Vancouver'\n    AND p.addr_state ILIKE 'WA'\n),\nelevation_check AS (\n  SELECT \n    c.poi_name,\n    c.geom,\n    (ST_Value(r.rast, 1, c.geom))::numeric AS elevation\n  FROM cafe_candidates c\n  JOIN public.dem_us r ON ST_Intersects(r.rast, c.geom)\n)\nSELECT \n  poi_name\nFROM elevation_check\nWHERE elevation >= 380;\n```",
