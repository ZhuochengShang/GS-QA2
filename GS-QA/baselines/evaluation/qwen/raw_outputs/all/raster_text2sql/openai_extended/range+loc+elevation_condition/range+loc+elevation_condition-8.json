  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-105.938507 35.68916)',4326)::geography, 1800)\n  AND p.amenity = 'fast_food'\n  AND elev.z >= 360;",
  "id": "range+loc+elevation_condition-8",
  "model_output": "```sql\nWITH antieau_point AS (\n  SELECT ST_SetSRID(ST_MakePoint(-105.938507, 35.68916), 4326)::geography AS geom\n),\ncinnabon_point AS (\n  SELECT ST_SetSRID(ST_MakePoint(-83.747942, 42.240649), 4326)::geography AS geom\n),\nbuffered_area AS (\n  SELECT ST_Buffer(antieau_point.geom, 1800) AS geom\n  FROM antieau_point\n),\ndem_clip AS (\n  SELECT ST_Union(rast) AS rast\n  FROM public.dem_us\n  WHERE ST_Intersects(rast, buffered_area.geom)\n),\nelevation_check AS (\n  SELECT \n    ST_Value(dem_clip.rast, cinnabon_point.geom) AS elevation\n  FROM dem_clip, cinnabon_point\n)\nSELECT \n  CASE \n    WHEN elevation_check.elevation >= 360 THEN 'Cinnabon, Ann Arbor, MI'\n    ELSE NULL\n  END AS location\nFROM elevation_check;\n```",
