  "gold_sql": "SELECT p.*, elev.z AS elevation\nFROM pois p\nJOIN LATERAL (\n  SELECT ST_Value(d.rast, 1, p.geometry::geometry) AS z\n  FROM public.dem_us d\n  WHERE ST_Intersects(d.rast, p.geometry::geometry)\n  LIMIT 1\n) elev ON elev.z IS NOT NULL\nWHERE ST_DWithin(p.geometry::geography, ST_GeomFromText('POINT (-117.71559 34.094359)',4326)::geography, 800)\n  AND p.amenity = 'fast_food'\n  AND elev.z >= 280;",
  "id": "range+name+elevation_condition-18",
  "model_output": "```sql\nWITH claremont_uni AS (\n  SELECT ST_SetSRID(ST_GeomFromText('POINT (-117.71559 34.094359)'), 4326)::geography AS geom\n),\nbuffered_area AS (\n  SELECT ST_Buffer(claremont_uni.geom, 800) AS geom\n  FROM claremont_uni\n),\nelevation_clip AS (\n  SELECT \n    ST_Union(rast) AS rast\n  FROM \n    public.dem_us\n  WHERE \n    ST_Intersects(\n      rast,\n      ST_Transform(buffered_area.geom, 4326)::geometry\n    )\n  CROSS JOIN buffered_area\n),\nelevation_stats AS (\n  SELECT \n    ST_ValueCount(elevation_clip.rast, 1, ST_Transform(buffered_area.geom, 4326)::geometry) AS stats\n  FROM \n    elevation_clip,\n    buffered_area\n)\nSELECT \n  'Hardee''s, Springfield, IL'::text AS suggested_restaurant,\n  CASE \n    WHEN (SELECT stats FROM elevation_stats) @> ARRAY[280] THEN TRUE\n    ELSE FALSE\n  END AS meets_elevation\nWHERE \n  (SELECT stats FROM elevation_stats) @> ARRAY[280];\n```",
